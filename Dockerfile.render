# =============================
# DOCKERFILE PARA RENDER - BACKEND SPRING BOOT
# =============================
# Optimizado para el plan free de Render
# =============================

# =============================
# STAGE 1 — Build Backend
# =============================
FROM maven:3.9.5-eclipse-temurin-17-alpine AS build
WORKDIR /app

# Copiar pom.xml primero para cachear dependencias
COPY pom.xml ./
RUN mvn dependency:go-offline -B

# Copiar código fuente
COPY src ./src

# Compilar el backend (sin tests para acelerar)
RUN mvn clean package -DskipTests -B

# =============================
# STAGE 2 — Runtime
# =============================
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Crear usuario no-root para seguridad
RUN addgroup -g 1000 appgroup && \
    adduser -u 1000 -G appgroup -D appuser

# Crear directorios necesarios
RUN mkdir -p /app/uploads /app/logs && \
    chown -R appuser:appgroup /app

# Copiar JAR generado
COPY --from=build /app/target/*.jar app.jar
RUN chown appuser:appgroup app.jar

# Variables de entorno optimizadas para Render Free Tier
ENV JAVA_OPTS="-Xms128m -Xmx256m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom"
ENV SERVER_PORT=8080
ENV TZ=America/Bogota

# Cambiar a usuario no-root
USER appuser

# Exponer puerto (Render usa la variable PORT)
EXPOSE 8080

# Comando de inicio - Render asigna el puerto via $PORT
CMD ["sh", "-c", "java $JAVA_OPTS -Dserver.port=${PORT:-8080} -jar app.jar"]
