# ============================================
# BASE DE DATOS
# ============================================
POSTGRES_DB=veterinaria_db
POSTGRES_USER=vet_admin
POSTGRES_PASSWORD=Petrico123

# ============================================
# BACKEND
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/veterinaria_db
SPRING_DATASOURCE_USERNAME=vet_admin
SPRING_DATASOURCE_PASSWORD=Petrico123

# JWT Configuration
APP_JWT_SECRET=Mi_Super_Secreto_Para_JWT_Veterinaria_2024_Debe_Ser_Muy_Largo_Minimo_512_Bits_Docker
APP_JWT_EXPIRATION=86400000

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Java Options
JAVA_OPTS=-Xms256m -Xmx512m

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8080/api

# ============================================
# GMAIL (Opcional - para notificaciones por email)
# ============================================
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# ============================================
# TIMEZONE
# ============================================
TZ=America/Bogota
